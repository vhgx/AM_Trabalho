# ==============================================================================
# Configurações do LLM (Compatível com OpenAI API)
# O sistema suporta tanto modelos executados localmente quanto APIs em nuvem.
# Copie este arquivo para .env e ajuste conforme sua preferência:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Opção 1: Execução Local com LM Studio (Padrão)
# ------------------------------------------------------------------------------
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=local-model

# ------------------------------------------------------------------------------
# Opção 2: Execução Local com Ollama
# ------------------------------------------------------------------------------
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------------------------
# Opção 3: API Comercial - OpenAI
# ------------------------------------------------------------------------------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-proj-sua-chave-aqui
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Opção 4: API Comercial - Groq (Alta velocidade com modelos open-source)
# ------------------------------------------------------------------------------
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_sua-chave-aqui
# OPENAI_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Opção 5: API Comercial - Google Gemini (Compatibilidade OpenAI)
# ------------------------------------------------------------------------------
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=sua-chave-gemini-aqui
# OPENAI_MODEL=gemini-1.5-flash
